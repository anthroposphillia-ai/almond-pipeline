# Almond Pipeline — 환경변수 템플릿
# 이 파일을 복사해서 .env로 저장 후 실제 키 입력
# cp .env.example .env

# 공공데이터포털 API 인증키
# 발급: https://www.data.go.kr → 유기동물 보호 공고 API 신청
ANIMAL_API_KEY=여기에_발급받은_키_입력

# Instagram Graph API
# 발급: https://developers.facebook.com
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# YouTube Data API v3
# 발급: https://console.cloud.google.com
YOUTUBE_API_KEY=

# TikTok Content Posting API
# 발급: https://developers.tiktok.com
TIKTOK_ACCESS_TOKEN=
